# TiDB Cloud or any MySQL 8-compatible database.
DATABASE_URL=mysql://user:password@host:4000/coin_terminal
DATABASE_SSL=true

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional separate key for encrypting per-user AI provider credentials.
# Falls back to BETTER_AUTH_SECRET when omitted.
AI_CREDENTIALS_ENCRYPTION_KEY=replace-with-a-long-random-secret

# Used by authenticated Vercel or Coolify cron endpoints. Vercel automatically
# sends this value as an Authorization bearer token for configured cron jobs.
CRON_SECRET=replace-with-a-long-random-job-secret

# Optional: required only for Ethereum/Base/Arbitrum wallet ingestion.
ETHERSCAN_API_KEY=

# Optional for local/non-Vercel model synthesis. Vercel deployments automatically
# use VERCEL_OIDC_TOKEN with AI Gateway, so do not set that generated token manually.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.6-luna

# Optional secondary provider when AI Gateway is unavailable.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Model providers receive only allowlisted financial fields: no record IDs,
# fingerprints, free-form notes, profile name, or email. With no provider
# credential, Ask Portfolio uses deterministic authenticated selectors.
