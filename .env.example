# TiDB Cloud or any MySQL 8-compatible database.
DATABASE_URL=mysql://user:password@host:4000/coin_terminal
DATABASE_SSL=true

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used by the authenticated Coolify cron endpoints.
CRON_SECRET=replace-with-a-long-random-job-secret

# Optional: required only for Ethereum/Base/Arbitrum wallet ingestion.
ETHERSCAN_API_KEY=
